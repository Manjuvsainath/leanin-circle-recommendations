{
  "name": "leanin-circle-recommendations",
  "version": "1.0.0",
  "private": true,
  "description": "API that recommends Lean In Circles to a member, with a member-facing explanation for each pick.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "recommend": "tsx scripts/recommend.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
